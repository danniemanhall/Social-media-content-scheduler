{
  "name": "roopip-content-calendar",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build",
    "preview": "npm run build && wrangler pages dev dist",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p . && tsc --noEmit -p functions",
    "db:migrate:local": "wrangler d1 migrations apply roopip-calendar --local",
    "db:migrate:remote": "wrangler d1 migrations apply roopip-calendar --remote"
  },
  "dependencies": {
    "@ffmpeg/ffmpeg": "^0.12.15",
    "@ffmpeg/util": "^0.12.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20241205.0",
    "@ffmpeg/core": "^0.12.10",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "vitest": "^2.1.8",
    "wrangler": "^3.95.0"
  }
}
